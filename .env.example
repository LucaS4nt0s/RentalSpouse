# =============================================================================
# RentalSpouse — Variáveis de Ambiente de Exemplo
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser versionado (está no .gitignore).
#
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=rentalspouse
# Dica: evite caracteres especiais como '$' ou '#' na senha local, pois o Docker Compose
# interpreta '$' como interpolação de variável de ambiente (a menos que seja escapado como '$$').
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=rentalspouse_db

# --- Backend FastAPI ---
# URL usada pelo container do backend para conectar ao banco.
# Formato: postgresql://<user>:<password>@<host>:<port>/<db>
# "db" é o nome do serviço no docker-compose.
DATABASE_URL=postgresql://rentalspouse:troque_esta_senha_forte@db:5432/rentalspouse_db

# --- Frontend Web (Next.js) ---
# URL pública da API consumida pelo cliente browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Modo mock opcional para desenvolvimento e testes isolados do fluxo de documentos (true/false)
NEXT_PUBLIC_DOCUMENTS_MOCK=false

# --- E-mail transacional (verificação de conta) ---
# Transporte de envio:
#   console -> escreve o e-mail no log da aplicação (padrão de desenvolvimento)
#   smtp    -> envio real via SMTP (mailpit local, Brevo, Gmail, etc.)
#   memoria -> retém as mensagens em memória (usado pelos testes automatizados)
EMAIL_BACKEND=console

# URL pública do frontend, usada para montar o link de verificação enviado por e-mail.
APP_BASE_URL=http://localhost:3000

# Remetente exibido nos e-mails transacionais.
# Nota: ao usar Gmail ou provedores que exigem validação de remetente, se EMAIL_FROM_ADDRESS
# for mantido como .local ou vazio, o sistema usa automaticamente o SMTP_USER configurado.
EMAIL_FROM_NAME=RentalSpouse
EMAIL_FROM_ADDRESS=nao-responda@rentalspouse.local
# Endereço de resposta (Reply-To) opcional para e-mails transacionais
EMAIL_REPLY_TO=

# Validade do link de verificação (horas) e intervalo mínimo entre reenvios (segundos).
EMAIL_VERIFICACAO_EXPIRA_HORAS=24
EMAIL_VERIFICACAO_REENVIO_SEGUNDOS=60

# --- SMTP (obrigatório somente quando EMAIL_BACKEND=smtp) ---
# Opção 1: Mailpit do docker-compose (desenvolvimento local sem envio à internet):
#   EMAIL_BACKEND=smtp
#   SMTP_HOST=mailpit (ou localhost fora do Docker)
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=false
#   Caixa de entrada visível em: http://localhost:8025
#
# Opção 2: Gmail (envio real para caixas postais reais - Caixa de Entrada / Spam):
#   EMAIL_BACKEND=smtp
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587          (ou 465 com SMTP_USE_SSL=true)
#   SMTP_USER=seu-email@gmail.com
#   SMTP_PASSWORD=abcd efgh ijkl mnop   (Senha de App de 16 caracteres gerada na Conta Google)
#   SMTP_USE_TLS=true      (ou false se usar porta 465 com SSL)
#   SMTP_USE_SSL=false     (ou true se usar porta 465)
#
# Opção 3: Brevo / Sendinblue / Resend (SMTP relay transacional):
#   EMAIL_BACKEND=smtp
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=seu-login-brevo
#   SMTP_PASSWORD=sua-master-key-brevo
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
# Tentativas de reenvio com backoff exponencial em caso de falha transitória de conexão/socket (1 a 5)
SMTP_MAX_RETRIES=3

# --- Segurança e Autenticação (JWT & Seed) ---
# Chave secreta para assinatura dos tokens JWT (obrigatória em produção, gere com `openssl rand -hex 32`)
JWT_SECRET=rentalspouse_dev_secret_key_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Semeadura do administrador inicial (em produção deve ser 'false' ou omitido se já semeado)
SEED_INITIAL_ADMIN=true
INITIAL_ADMIN_NAME=Administrador Inicial
INITIAL_ADMIN_EMAIL=admin@rentalspouse.com
INITIAL_ADMIN_PASSWORD=Admin@123456
